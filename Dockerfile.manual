FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    fonts-liberation \
    novnc \
    websockify \
    x11vnc \
    xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 worker \
    && useradd --uid 10001 --gid worker --create-home --shell /usr/sbin/nologin worker

WORKDIR /app
COPY manual-browser.sh ./
RUN chmod 755 /app/manual-browser.sh && mkdir -p /profile && chown worker:worker /profile /app

ENV GOOGLE_LENS_PROFILE_DIR=/profile
USER worker:worker
EXPOSE 6080
CMD ["/app/manual-browser.sh"]
